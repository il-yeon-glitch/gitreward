# 이 파일은 빈 껍데기다. 값이 없으니 커밋해도 된다.
# 이걸 복사해서 .env 를 만들고, 진짜 값은 .env 에만 적는다.
#
#   Windows:  copy .env.example .env
#
# .env 는 .gitignore 에 들어 있어서 커밋되지 않는다.
# .env 를 카톡이나 디스코드로 주고받지 않는다. 채팅 기록에 토큰이 남는다.

# github.com/settings/tokens 에서 발급. 권한(scope) 은 체크하지 않아도 된다.
# 각자 따로 발급받는다.
GITHUB_TOKEN=

# 디스코드 개발자 포털 > 내 앱 > Bot 탭에서 발급.
# 담당자 한 명만 가진다. 두 명이 같은 토큰으로 봇을 켜면 응답이 중복되거나 충돌한다.
DISCORD_TOKEN=

# 디스코드 서버(길드) ID. 비밀이 아니라 팀끼리 공유해도 된다.
# 디스코드 설정에서 개발자 모드를 켠 뒤, 서버 이름 우클릭 > "서버 ID 복사".
# 슬래시 명령을 이 서버에만 등록할 때 쓴다. 전역 등록은 반영이 느리다.
DISCORD_GUILD_ID=

# GitHub OAuth App (github.com/settings/developers > New OAuth App 에서 발급).
# Authorization callback URL 은 config.py 의 WEB_BASE_URL + "/callback" 과 똑같아야 한다.
#   예) http://127.0.0.1:5000/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
